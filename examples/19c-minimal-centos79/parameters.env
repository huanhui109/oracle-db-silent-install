# Deployment profile: 19c, minimal, local-only, non-CDB
#
# These are the exact parameters behind every artifact in this directory.
# They are also what `scripts/show_plan.sh` prints at the top of the plan sheet.
# Source it before re-generating the examples:
#   set -a; . ./parameters.env; set +a

export VERSION=19c
export ORACLE_BASE=/u01/app/oracle
export ORACLE_HOME=/u01/app/oracle/product/19.0.0/dbhome_1
export ORACLE_SID=orcl
export GDBNAME=orcl
export CHARSET=ZHS16GBK
export NCHARSET=AL16UTF16
export CDB_MODE=false

# Memory: the rsp pins these values. references/planning.md derives them from
# physical RAM with clamp(round(M*0.14), 512, 2048); on this 3.7 GB VM the
# formula suggests 528M, and 512M was the value actually verified in place.
# PHYSICAL_RAM_MB lets the example regenerate identically on a machine without
# /proc/meminfo (macOS, or the control host).
export PHYSICAL_RAM_MB=3775
export SGA_MB=512
export PGA_MB=256
export PROCESSES=100

# Local-only listener. Change to 0.0.0.0 only if the database must be reachable
# from other hosts, and then open 1521 in the firewall explicitly.
export BIND_HOST=127.0.0.1
export PORT=1521

# Platform context (outside Oracle's supported matrix; see references/version-matrix.md)
export OS_NAME=CentOS
export OS_VERSION=7.9
export OS_SUPPORT_NOTE="CV_ASSUME_DISTID=OL7 required; platform is not Oracle-supported"

# SSH alias used in the plan sheet examples.
export HOST_ALIAS=orcl19c
