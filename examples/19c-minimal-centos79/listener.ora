# Generated by oracle-db-silent-install / scripts/gen_listener_ora.sh
# Bind address 127.0.0.1:1521 -> loopback only - not reachable from other hosts
# Reload with: lsnrctl reload   (or: lsnrctl stop && lsnrctl start)
LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = 127.0.0.1)(PORT = 1521))
      (ADDRESS = (PROTOCOL = IPC)(KEY = EXTPROC1521))
    )
  )

ADR_BASE_LISTENER = /u01/app/oracle
