# Deployment profile: 11gR2, legacy response-file schema
#
# 11gR2 is out of Oracle support. It is included because plenty of test rigs
# still run it, and because it makes the version matrix concrete: no CDB keys,
# no initParams, older glibc floor.

export VERSION=11g
export ORACLE_BASE=/u01/app/oracle
export ORACLE_HOME=/u01/app/oracle/product/11.2.0/dbhome_1
export ORACLE_SID=orcl11g
export GDBNAME=orcl11g
export CHARSET=AL32UTF8
export NCHARSET=AL16UTF16
export CDB_MODE=false          # ignored on 11g: there is no CDB architecture

# 11g takes dedicated memory keys (sgaTarget / pgaAggregateTarget / processes).
export SGA_MB=800
export PGA_MB=400
export PROCESSES=150

export BIND_HOST=127.0.0.1
export PORT=1521

export OS_NAME=RHEL
export OS_VERSION=6.7
export OS_SUPPORT_NOTE="glibc 2.12: fine for 11g, fatal for 19c"

export HOST_ALIAS=orcl11g
